<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leap_hand_gazebo">

  <!-- Include the original LEAP Hand URDF -->
  <xacro:include filename="$(find leap_hand_description)/urdf/robot.urdf"/>
  

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="mcp_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="pip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="dip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="fingertip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="thumb_pip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="thumb_dip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>

    <joint name="thumb_fingertip">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find leap_hand_gazebo)/config/leap_hand_controllers.yaml</parameters>
    </plugin>
  </gazebo>

     <!-- ============ GAZEBO MATERIAL PROPERTIES ============ -->
  <gazebo reference="palm_lower">
    <static>true</static> <!-- THIS BOLTS THE HAND TO THE WORLD -->
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="index_proximal">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="index_distal">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
  </gazebo>

</robot>
